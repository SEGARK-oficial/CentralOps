{
  "_comment": [
    "SEGARK EDR feed process_events (GET /api/integrations/v1/events) -> Process Activity (1007).",
    "Colunas do agente sao texto; numeros via to_int. Opcionais so via when.exists (sem null no OCSF)."
  ],
  "rules": [
    {
      "target": "normalized.class_uid",
      "const": 1007,
      "required": true
    },
    {
      "target": "normalized.class_name",
      "const": "Process Activity"
    },
    {
      "target": "normalized.category_uid",
      "const": 1,
      "required": true
    },
    {
      "target": "normalized.category_name",
      "const": "System Activity"
    },
    {
      "_comment": "Linux: a linha e um execve (syscall) -> Launch. Windows (ETW): action start/exit -> Launch/Terminate; carga de imagem e outros -> Other (99), sem fingir Process Activity especifica.",
      "target": "normalized.activity_id",
      "source": "(columns.action || (contains(['execve', 'execveat'], columns.syscall || '') && 'start') || '')",
      "value_map": {
        "start": 1,
        "exit": 2,
        "image_load": 99,
        "image_unload": 99,
        "event": 99
      },
      "default": 0,
      "required": true
    },
    {
      "target": "normalized.activity_name",
      "source": "(columns.action || (contains(['execve', 'execveat'], columns.syscall || '') && 'start') || '')",
      "value_map": {
        "start": "Launch",
        "exit": "Terminate",
        "image_load": "Other",
        "image_unload": "Other",
        "event": "Other"
      },
      "default": "Unknown"
    },
    {
      "target": "normalized.type_uid",
      "source": "(columns.action || (contains(['execve', 'execveat'], columns.syscall || '') && 'start') || '')",
      "value_map": {
        "start": 100701,
        "exit": 100702,
        "image_load": 100799,
        "image_unload": 100799,
        "event": 100799
      },
      "default": 100700,
      "required": true
    },
    {
      "target": "normalized.severity_id",
      "const": 1,
      "required": true
    },
    {
      "target": "normalized.severity",
      "const": "Informational"
    },
    {
      "_comment": "observed_at = quando o agente viu (UTC com Z); received_at = quando a plataforma gravou.",
      "target": "normalized.time",
      "source": "observed_at",
      "type_cast": "iso_to_epoch",
      "required": true
    },
    {
      "target": "normalized.metadata.logged_time",
      "source": "received_at",
      "when": {
        "exists": "received_at"
      },
      "type_cast": "iso_to_epoch"
    },
    {
      "target": "normalized.metadata.version",
      "const": "1.8.0"
    },
    {
      "target": "normalized.metadata.product.name",
      "const": "SEGARK EDR"
    },
    {
      "target": "normalized.metadata.product.vendor_name",
      "const": "SEGARK"
    },
    {
      "target": "normalized.metadata.uid",
      "source": "event_id",
      "default": null
    },
    {
      "target": "normalized.metadata.log_name",
      "const": "process_events"
    },
    {
      "target": "normalized.device.uid",
      "source": "device_id",
      "default": null
    },
    {
      "target": "normalized.device.hostname",
      "source": "hostname",
      "default": null
    },
    {
      "target": "normalized.device.name",
      "source": "hostname",
      "default": null
    },
    {
      "target": "normalized.device.type_id",
      "const": 0
    },
    {
      "target": "normalized.device.type",
      "const": "Unknown"
    },
    {
      "target": "normalized.device.os.name",
      "source": "device_os",
      "value_map": {
        "linux": "Linux",
        "windows": "Windows"
      },
      "when": {
        "exists": "device_os"
      }
    },
    {
      "target": "normalized.device.os.type_id",
      "source": "device_os",
      "value_map": {
        "linux": 200,
        "windows": 100
      },
      "default": 0,
      "when": {
        "exists": "device_os"
      }
    },
    {
      "_comment": "Linhas agregadas na janela da tabela do agente: count = eventos iguais fundidos.",
      "target": "normalized.count",
      "source": "columns.count",
      "type_cast": "to_int",
      "when": {
        "exists": "(columns.count) || `null`"
      }
    },
    {
      "target": "normalized.unmapped.segark_edr.time_flag",
      "source": "(time_flag) || `null`",
      "when": {
        "exists": "(time_flag) || `null`"
      }
    },
    {
      "target": "normalized.unmapped.segark_edr.container_id",
      "source": "(columns.container_id) || `null`",
      "when": {
        "exists": "(columns.container_id) || `null`"
      }
    },
    {
      "target": "normalized.unmapped.segark_edr.eid",
      "source": "(columns.eid) || `null`",
      "when": {
        "exists": "(columns.eid) || `null`"
      }
    },
    {
      "target": "normalized.process.pid",
      "source": "columns.pid",
      "type_cast": "to_int",
      "when": {
        "exists": "(columns.pid) || `null`"
      }
    },
    {
      "_comment": "process_guid do contrato de contexto (sobrevive ao reuso de PID) -> process.uid; o mesmo de evidences.process.uid das deteccoes.",
      "target": "normalized.process.uid",
      "source": "(columns.process_guid) || `null`",
      "when": {
        "exists": "(columns.process_guid) || `null`"
      }
    },
    {
      "target": "normalized.process.cmd_line",
      "source": "(columns.cmdline) || `null`",
      "when": {
        "exists": "(columns.cmdline) || `null`"
      }
    },
    {
      "target": "normalized.process.file.path",
      "source": "(columns.path) || `null`",
      "when": {
        "exists": "(columns.path) || `null`"
      }
    },
    {
      "target": "normalized.process.integrity",
      "source": "(columns.integrity) || `null`",
      "when": {
        "exists": "(columns.integrity) || `null`"
      }
    },
    {
      "target": "normalized.process.working_directory",
      "source": "(columns.cwd) || `null`",
      "when": {
        "exists": "(columns.cwd) || `null`"
      }
    },
    {
      "target": "normalized.process.user.uid",
      "source": "columns.user_sid || (columns.uid != '4294967295' && columns.uid) || `null`",
      "when": {
        "exists": "columns.user_sid || (columns.uid != '4294967295' && columns.uid) || `null`"
      }
    },
    {
      "target": "normalized.process.user.name",
      "source": "(columns.user) || `null`",
      "when": {
        "exists": "(columns.user) || `null`"
      }
    },
    {
      "target": "normalized.process.parent_process.pid",
      "source": "columns.parent",
      "type_cast": "to_int",
      "when": {
        "exists": "(columns.parent) || `null`"
      }
    },
    {
      "target": "normalized.process.parent_process.uid",
      "source": "(columns.parent_guid) || `null`",
      "when": {
        "exists": "(columns.parent_guid) || `null`"
      }
    },
    {
      "_comment": "Em Launch o ator e o processo pai (OCSF): os mesmos pid/uid do pai.",
      "target": "normalized.actor.process.pid",
      "source": "columns.parent",
      "type_cast": "to_int",
      "when": {
        "exists": "(columns.parent) || `null`"
      }
    },
    {
      "target": "normalized.actor.process.uid",
      "source": "(columns.parent_guid) || `null`",
      "when": {
        "exists": "(columns.parent_guid) || `null`"
      }
    },
    {
      "target": "normalized.unmapped.segark_edr.syscall",
      "source": "(columns.syscall) || `null`",
      "when": {
        "exists": "(columns.syscall) || `null`"
      }
    },
    {
      "target": "normalized.unmapped.segark_edr.session_id",
      "source": "(columns.session_id) || `null`",
      "when": {
        "exists": "(columns.session_id) || `null`"
      }
    },
    {
      "target": "normalized.unmapped.segark_edr.elevated",
      "source": "(columns.elevated) || `null`",
      "when": {
        "exists": "(columns.elevated) || `null`"
      }
    },
    {
      "target": "normalized.unmapped.segark_edr.elevation_type",
      "source": "(columns.elevation_type) || `null`",
      "when": {
        "exists": "(columns.elevation_type) || `null`"
      }
    },
    {
      "target": "normalized.observables",
      "kind": "array_builder",
      "items": [
        {
          "name": "device.hostname",
          "type": "Hostname",
          "type_id": 1,
          "source": "hostname",
          "skip_null": true
        },
        {
          "name": "process.file.path",
          "type": "File Name",
          "type_id": 7,
          "source": "columns.path",
          "skip_null": true
        },
        {
          "name": "process.user.name",
          "type": "User Name",
          "type_id": 4,
          "source": "columns.user",
          "skip_null": true
        }
      ],
      "skip_null": true,
      "dedup_by": [
        "value"
      ]
    }
  ],
  "raw_reduction": [
    {
      "drop_nulls": true
    }
  ]
}
