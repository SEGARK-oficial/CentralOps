{
  "_comment": [
    "SEGARK EDR feed dns_events -> DNS Activity (4003)."
  ],
  "rules": [
    {
      "target": "normalized.class_uid",
      "const": 4003,
      "required": true
    },
    {
      "target": "normalized.class_name",
      "const": "DNS Activity"
    },
    {
      "target": "normalized.category_uid",
      "const": 4,
      "required": true
    },
    {
      "target": "normalized.category_name",
      "const": "Network Activity"
    },
    {
      "_comment": "O sensor ve a consulta (qname, tipo, resolvedor); a resposta nao vem na linha.",
      "target": "normalized.activity_id",
      "source": "'query'",
      "value_map": {
        "query": 1
      },
      "default": 0,
      "required": true
    },
    {
      "target": "normalized.activity_name",
      "source": "'query'",
      "value_map": {
        "query": "Query"
      },
      "default": "Unknown"
    },
    {
      "target": "normalized.type_uid",
      "source": "'query'",
      "value_map": {
        "query": 400301
      },
      "default": 400300,
      "required": true
    },
    {
      "target": "normalized.severity_id",
      "const": 1,
      "required": true
    },
    {
      "target": "normalized.severity",
      "const": "Informational"
    },
    {
      "_comment": "observed_at = quando o agente viu (UTC com Z); received_at = quando a plataforma gravou.",
      "target": "normalized.time",
      "source": "observed_at",
      "type_cast": "iso_to_epoch",
      "required": true
    },
    {
      "target": "normalized.metadata.logged_time",
      "source": "received_at",
      "when": {
        "exists": "received_at"
      },
      "type_cast": "iso_to_epoch"
    },
    {
      "target": "normalized.metadata.version",
      "const": "1.8.0"
    },
    {
      "target": "normalized.metadata.product.name",
      "const": "SEGARK EDR"
    },
    {
      "target": "normalized.metadata.product.vendor_name",
      "const": "SEGARK"
    },
    {
      "target": "normalized.metadata.uid",
      "source": "event_id",
      "default": null
    },
    {
      "target": "normalized.metadata.log_name",
      "const": "dns_events"
    },
    {
      "target": "normalized.device.uid",
      "source": "device_id",
      "default": null
    },
    {
      "target": "normalized.device.hostname",
      "source": "hostname",
      "default": null
    },
    {
      "target": "normalized.device.name",
      "source": "hostname",
      "default": null
    },
    {
      "target": "normalized.device.type_id",
      "const": 0
    },
    {
      "target": "normalized.device.type",
      "const": "Unknown"
    },
    {
      "target": "normalized.device.os.name",
      "source": "device_os",
      "value_map": {
        "linux": "Linux",
        "windows": "Windows"
      },
      "when": {
        "exists": "device_os"
      }
    },
    {
      "target": "normalized.device.os.type_id",
      "source": "device_os",
      "value_map": {
        "linux": 200,
        "windows": 100
      },
      "default": 0,
      "when": {
        "exists": "device_os"
      }
    },
    {
      "_comment": "Linhas agregadas na janela da tabela do agente: count = eventos iguais fundidos.",
      "target": "normalized.count",
      "source": "columns.count",
      "type_cast": "to_int",
      "when": {
        "exists": "(columns.count) || `null`"
      }
    },
    {
      "target": "normalized.unmapped.segark_edr.time_flag",
      "source": "(time_flag) || `null`",
      "when": {
        "exists": "(time_flag) || `null`"
      }
    },
    {
      "target": "normalized.unmapped.segark_edr.container_id",
      "source": "(columns.container_id) || `null`",
      "when": {
        "exists": "(columns.container_id) || `null`"
      }
    },
    {
      "target": "normalized.unmapped.segark_edr.eid",
      "source": "(columns.eid) || `null`",
      "when": {
        "exists": "(columns.eid) || `null`"
      }
    },
    {
      "target": "normalized.actor.process.pid",
      "source": "columns.pid",
      "type_cast": "to_int",
      "when": {
        "exists": "(columns.pid) || `null`"
      }
    },
    {
      "target": "normalized.actor.process.file.path",
      "source": "(columns.executable) || `null`",
      "when": {
        "exists": "(columns.executable) || `null`"
      }
    },
    {
      "_comment": "uid 4294967295 = desconhecido no contrato do agente: fica fora.",
      "target": "normalized.actor.process.user.uid",
      "source": "columns.uid",
      "when": {
        "exists": "columns.uid != '4294967295' && columns.uid || `null`"
      }
    },
    {
      "target": "normalized.query.hostname",
      "source": "columns.query",
      "default": null
    },
    {
      "target": "normalized.query.type",
      "source": "(columns.query_type) || `null`",
      "when": {
        "exists": "(columns.query_type) || `null`"
      }
    },
    {
      "target": "normalized.dst_endpoint.ip",
      "source": "(columns.resolver) || `null`",
      "when": {
        "exists": "(columns.resolver) || `null`"
      }
    },
    {
      "target": "normalized.observables",
      "kind": "array_builder",
      "items": [
        {
          "name": "device.hostname",
          "type": "Hostname",
          "type_id": 1,
          "source": "hostname",
          "skip_null": true
        },
        {
          "name": "query.hostname",
          "type": "Hostname",
          "type_id": 1,
          "source": "columns.query",
          "skip_null": true
        },
        {
          "name": "dst_endpoint.ip",
          "type": "IP Address",
          "type_id": 2,
          "source": "columns.resolver",
          "skip_null": true
        }
      ],
      "skip_null": true,
      "dedup_by": [
        "value"
      ]
    }
  ],
  "raw_reduction": [
    {
      "drop_nulls": true
    }
  ]
}
